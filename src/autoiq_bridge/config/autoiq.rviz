        ego_vehicle/sensor/lidar/at128_front:
          Value: true
        ego_vehicle/sensor/lidar/top:
          Value: true
        map:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          ego_vehicle:
            ego_vehicle/ground_truth/camera/semantic/front:
              {}
            ego_vehicle/ground_truth/lidar/top_semantic:
              {}
            ego_vehicle/sensor/camera/depth/front:
              {}
            ego_vehicle/sensor/camera/rgb/back:
              {}
            ego_vehicle/sensor/camera/rgb/front:
              {}
            ego_vehicle/sensor/camera/rgb/left:
              {}
            ego_vehicle/sensor/camera/rgb/right:
              {}
            ego_vehicle/sensor/gnss/gnss:
              {}
            ego_vehicle/sensor/imu/imu:
              {}
            ego_vehicle/sensor/lidar/at128_front:
              {}
            ego_vehicle/sensor/lidar/top:
              {}
