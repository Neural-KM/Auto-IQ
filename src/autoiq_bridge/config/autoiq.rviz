Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /GD Semantics+Lidar Overlay1/Topic1
        - /Real semantics+Lane Pixels1/Topic1
        - /Real Semantics1/Topic1
        - /Mapping - Drop skirt debug1/Topic1
      Splitter Ratio: 0.5
    Tree Height: 316
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
      - /Current View1/Enable Stereo Rendering1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
